<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Required by the Microsoft.AspNetCore.OpenApi source generator that lifts XML docs into the document -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.2.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
        <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\src\RootBlocks.AspNetCore.OpenApi\RootBlocks.AspNetCore.OpenApi.csproj" />
        <ProjectReference Include="..\..\..\..\src\RootBlocks.Logging.Serilog\RootBlocks.Logging.Serilog.csproj" />
        <ProjectReference Include="..\..\..\..\src\RootBlocks.Serialization.Newtonsoft.Json\RootBlocks.Serialization.Newtonsoft.Json.csproj" />
        <ProjectReference Include="..\Blogs.Application\Blogs.Application.csproj" />
        <ProjectReference Include="..\Blogs.Infrastructure\Blogs.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>

</Project>
